#!/bin/bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$script_dir/platform-config"

for argument in "$@"; do
  case "$argument" in
    --download-cef)
      system_cef=OFF
      ;;
    *)
      echo "Usage: $0 [--download-cef]" >&2
      exit 1
      ;;
  esac
done

case "$ID" in
  arch)
    cef_packages=()
    if [[ "$system_cef" == ON ]]; then
      cef_packages+=(cef)
    fi
    pacman -Syu --noconfirm
    pacman -S --noconfirm --needed \
      base-devel cmake ninja pkgconf curl git \
      boost boost-libs ffmpeg glew libglvnd \
      onetbb openal sfml libxrandr simde ttf-liberation \
      gtk3 nss alsa-lib libcups libxcomposite libxdamage \
      "${cef_packages[@]}"
    exit 0
    ;;
  fedora|rocky|opensuse-leap|opensuse-tumbleweed)
    exec env system_cef="$system_cef" platform_id="$ID" bash "$script_dir/install-dependencies-rpm"
    ;;
  ubuntu|debian)
    apt-get update
    ;;
  *)
    echo "Unsupported distribution: $ID. See BUILDING.md for supported platforms." >&2
    exit 1
    ;;
esac

apt-get install -yq --no-install-recommends \
  autoconf \
  automake \
  cmake \
  ninja-build \
  curl \
  bzip2 \
  clang \
  g++ \
  gcc \
  git \
  fonts-liberation \
  gperf \
  libtool \
  make \
  perl \
  pkg-config \
  python3 \
  xz-utils \
  zlib1g-dev \
  libexpat1-dev \
  lsb-release \
  libglew-dev \
  libicu-dev \
  libtbb-dev \
  libopenal-dev \
  libxcursor-dev \
  libxinerama-dev \
  libxi-dev \
  libsfml-dev \
  libxrandr-dev \
  libudev-dev \
  libglu1-mesa-dev \
  libgl1-mesa-dev \
  libegl1-mesa-dev \
  libboost-all-dev \
  libasound2-dev \
  libdrm-dev \
  libgbm-dev \
  libgtk-3-dev \
  libnss3-dev \
  libcups2-dev \
  libxdamage-dev \
  libxcomposite-dev \
  libatk1.0-dev \
  libatspi2.0-dev \
  libatk-bridge2.0-dev \
  libavcodec-dev \
  libavformat-dev \
  libavdevice-dev \
  libavutil-dev \
  libavfilter-dev \
  libswscale-dev \
  libswresample-dev \
  libsimde-dev

if [[ "$ID" == ubuntu && "$system_cef" == ON ]]; then
  apt-get install -yq --no-install-recommends software-properties-common
  add-apt-repository -y ppa:casparcg/ppa
  apt-get update
  apt-get install -yq --no-install-recommends casparcg-cef-api15000-dev
fi
