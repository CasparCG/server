#!/bin/bash

set -euo pipefail

source /etc/os-release

case "$ID" in
  fedora)
    cef_packages=()
    if [[ "${system_cef:-ON}" == ON ]]; then
      cef_packages+=(cef-devel)
    fi
    dnf -y --setopt=install_weak_deps=False install \
      cmake ninja-build gcc gcc-c++ git make pkgconf-pkg-config curl tar bzip2 \
      liberation-mono-fonts cups-libs \
      boost-devel SFML-devel glew-devel tbb-devel openal-soft-devel \
      libglvnd-devel libX11-devel libXrandr-devel \
      gtk3-devel nss-devel alsa-lib-devel mesa-libgbm-devel libdrm-devel libicu-devel \
      ffmpeg-free-devel "${cef_packages[@]}"
    ;;
  rocky)
    echo "Rocky Linux builds are deferred until the SFML dependency is removed." >&2
    exit 1
    ;;
  opensuse-leap|opensuse-tumbleweed)
    zypper --non-interactive refresh
    zypper --non-interactive install --no-recommends \
      cmake ninja gcc gcc-c++ git make pkg-config curl tar bzip2 \
      liberation-fonts libcups2 \
      boost-devel 'cmake(SFML)' \
      libboost_thread-devel libboost_filesystem-devel libboost_log-devel \
      libboost_locale-devel libboost_regex-devel libboost_date_time-devel \
      libboost_coroutine-devel \
      'pkgconfig(gtk+-3.0)' 'pkgconfig(nss)' 'pkgconfig(alsa)' \
      'pkgconfig(gbm)' 'pkgconfig(libdrm)' 'pkgconfig(icu-uc)' \
      'pkgconfig(glew)' 'pkgconfig(tbb)' 'pkgconfig(openal)' \
      'pkgconfig(gl)' 'pkgconfig(glx)' 'pkgconfig(egl)' \
      'pkgconfig(x11)' 'pkgconfig(xrandr)' \
      'pkgconfig(libavcodec)' 'pkgconfig(libavformat)' \
      'pkgconfig(libavdevice)' 'pkgconfig(libavutil)' \
      'pkgconfig(libavfilter)' 'pkgconfig(libswscale)' \
      'pkgconfig(libswresample)'
    ;;
  *)
    echo "Unsupported RPM distribution: $ID" >&2
    exit 1
    ;;
esac