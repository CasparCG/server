#!/bin/bash

source /etc/os-release

# Normalize distro derivatives (e.g. Linux Mint, Pop!_OS, Manjaro) to their parent ID via ID_LIKE,
# so they fall into one of the supported branches below instead of always hitting "Unsupported
# distribution". Exact IDs already handled below are left untouched.
case "$ID" in
  ubuntu|arch|fedora|debian|opensuse-leap|opensuse-tumbleweed|rocky) ;;
  *)
    for like in ${ID_LIKE:-}; do
      case "$like" in
        ubuntu|debian|arch|fedora)
          ID="$like"
          break
          ;;
      esac
    done
    ;;
esac

case "$ID" in
  ubuntu)
    system_cef=ON
    font_path=/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf
    ;;
  arch)
    system_cef=ON
    font_path=/usr/share/fonts/liberation/LiberationMono-Regular.ttf
    ;;
  fedora)
    system_cef=ON
    font_path=/usr/share/fonts/liberation-mono-fonts/LiberationMono-Regular.ttf
    ;;
  debian)
    system_cef=OFF
    font_path=/usr/share/fonts/truetype/liberation/LiberationMono-Regular.ttf
    ;;
  opensuse-leap|opensuse-tumbleweed)
    system_cef=OFF
    font_path=/usr/share/fonts/truetype/LiberationMono-Regular.ttf
    ;;
  rocky)
    echo "Rocky Linux builds are deferred until the SFML dependency is removed." >&2
    exit 1
    ;;
  *)
    echo "Unsupported distribution: $ID. See BUILDING.md for supported platforms." >&2
    exit 1
    ;;
esac