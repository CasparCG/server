#!/bin/bash

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir/../.."
source /etc/os-release

package_inventory() {
  case "$ID" in
    ubuntu|debian)
      dpkg-query -W -f='${binary:Package}\t${Version}\t${Architecture}\t${db:Status-Status}\n'
      ;;
    arch)
      pacman -Q
      ;;
    fedora|opensuse-leap|opensuse-tumbleweed)
      rpm -qa --qf '%{NAME}\t%{EPOCHNUM}:%{VERSION}-%{RELEASE}\t%{ARCH}\n'
      ;;
    *)
      echo "Unsupported distribution for dependency fingerprint: $ID" >&2
      return 1
      ;;
  esac
}

export LC_ALL=C
{
  cat /etc/os-release
  package_inventory | sort
  cmake --version
  c++ --version
  ld --version
  {
    find src -type f -name CMakeLists.txt -print0
    find src/CMakeModules tools/linux -type f -print0
    printf '%s\0' tools/build.sh .github/workflows/linux-system.yml
  } |
    sort -z |
    while IFS= read -r -d '' file; do
      sha256sum "$file"
    done
} | sha256sum | cut -d ' ' -f 1
